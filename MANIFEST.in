include LICENSE README.md
prune docs
include docs/sdk.md docs/sdk-package.md docs/publishing.md
prune tests
include tests/test_cli.py tests/test_codec.py tests/test_compression.py
include tests/test_models.py tests/test_serialization.py
include tests/test_best_effort.py
prune research
recursive-include research/samples *.json
prune scripts
prune licenses
prune examples
prune .github
prune demo
prune build
prune dist
prune src/czn_deckcode/assets
exclude CZNDeckcode.spec run-ui.sh 启动卡组工具.cmd
global-exclude *.png *.gif *.jpg *.svg *.html *.exe *.pyc
